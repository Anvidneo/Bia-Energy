# Backend
PORT=8080
DATABASE_URL=postgres://bia:bia@localhost:5432/bia_energy?sslmode=disable
USE_LLM_EXPLAINER=false

# Required when USE_LLM_EXPLAINER=true: a Gemini API key (Google AI Studio
# free tier). Get yours at https://aistudio.google.com/apikey — never commit
# a real value here.
# LLM_API_KEY=
# Optional: defaults to gemini-2.5-flash if unset.
# LLM_MODEL=gemini-2.5-flash

USE_FIREBASE_ALERTS=false

# Required when USE_FIREBASE_ALERTS=true. Create a Firebase project
# (Spark/free tier is enough), enable Firestore in native mode, then create
# a service account with Firestore write access and paste its JSON key
# below (the whole file's contents, as one line) — never commit a real
# value here.
# FIREBASE_PROJECT_ID=
# FIREBASE_CREDENTIALS_JSON=

# Frontend (Vite)
VITE_API_URL=http://localhost:8080
